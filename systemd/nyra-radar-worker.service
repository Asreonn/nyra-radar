[Unit]
PartOf=nyra-radar.target
Description=Nyra Radar collection and enrichment worker
After=network-online.target nyra-radar-api.service
Wants=network-online.target

[Service]
TimeoutStopSec=20
Type=simple
WorkingDirectory=/home/asreonn/Apps/nyra-radar
ExecStart=/home/asreonn/Apps/nyra-radar/.venv/bin/radar worker
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Nice=10
IOSchedulingClass=idle
CPUQuota=150%
MemoryHigh=3G
MemoryMax=5G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/asreonn/.local/share/nyra-radar /home/asreonn/.cache/nyra-radar /home/asreonn/.config/nyra-radar /run/user/1000/nyra-radar

[Install]
WantedBy=default.target
